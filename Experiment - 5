#include <iostream>
#include <vector>
#include <algorithm>
#include <climits>
using namespace std;

// Structure for an edge
struct Edge {
    int u, v, weight;
};

// Structure for Disjoint Set Union (used in Kruskal's Algorithm)
struct DSU {
    vector<int> parent, rank;

    DSU(int n) {
        parent.resize(n);
        rank.resize(n, 0);

        for (int i = 0; i < n; i++)
            parent[i] = i;
    }

    int find(int x) {
        if (parent[x] != x)
            parent[x] = find(parent[x]);

        return parent[x];
    }

    void unite(int a, int b) {
        a = find(a);
        b = find(b);

        if (a != b) {
            if (rank[a] < rank[b])
                swap(a, b);

            parent[b] = a;

            if (rank[a] == rank[b])
                rank[a]++;
        }
    }
};

// Prim's Algorithm
void primMST(vector<vector<int>> graph, int V) {
    vector<int> key(V, INT_MAX);
    vector<int> parent(V, -1);
    vector<bool> inMST(V, false);

    key[0] = 0;

    for (int count = 0; count < V - 1; count++) {
        int u = -1;

        // Find vertex with minimum key value
        for (int v = 0; v < V; v++) {
            if (!inMST[v] && (u == -1 || key[v] < key[u]))
                u = v;
        }

        inMST[u] = true;

        // Update key values of adjacent vertices
        for (int v = 0; v < V; v++) {
            if (graph[u][v] != 0 && !inMST[v] &&
                graph[u][v] < key[v]) {
                key[v] = graph[u][v];
                parent[v] = u;
            }
        }
    }

    int totalCost = 0;

    cout << "\nMinimum Spanning Tree using Prim's Algorithm:\n";

    for (int i = 1; i < V; i++) {
        cout << parent[i] << " - " << i
             << " : " << graph[i][parent[i]] << endl;

        totalCost += graph[i][parent[i]];
    }

    cout << "Total Cost = " << totalCost << endl;
}

// Kruskal's Algorithm
void kruskalMST(vector<Edge> edges, int V) {

    // Sort edges according to weight
    sort(edges.begin(), edges.end(),
         [](Edge a, Edge b) {
             return a.weight < b.weight;
         });

    DSU dsu(V);

    int totalCost = 0;
    int edgeCount = 0;

    cout << "\nMinimum Spanning Tree using Kruskal's Algorithm:\n";

    for (Edge edge : edges) {

        int u = edge.u;
        int v = edge.v;

        // Check whether adding edge creates a cycle
        if (dsu.find(u) != dsu.find(v)) {

            cout << u << " - " << v
                 << " : " << edge.weight << endl;

            totalCost += edge.weight;
            dsu.unite(u, v);
            edgeCount++;

            if (edgeCount == V - 1)
                break;
        }
    }

    cout << "Total Cost = " << totalCost << endl;
}

int main() {

    int V, E;

    cout << "Enter number of vertices: ";
    cin >> V;

    cout << "Enter number of edges: ";
    cin >> E;

    // Adjacency matrix for Prim's Algorithm
    vector<vector<int>> graph(V, vector<int>(V, 0));

    // Edge list for Kruskal's Algorithm
    vector<Edge> edges;

    cout << "Enter edges (source destination weight):\n";

    for (int i = 0; i < E; i++) {

        int u, v, weight;
        cin >> u >> v >> weight;

        graph[u][v] = weight;
        graph[v][u] = weight;

        edges.push_back({u, v, weight});
    }

    primMST(graph, V);

    kruskalMST(edges, V);

    return 0;
}
